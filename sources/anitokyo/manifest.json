      "parameters": {
        "isNsfw": "false"
      },
      "network": {
        "origins": [
          "https://anitokyo.tv",
          "https://kodik.info",
          "https://kodikplayer.com",
          "https://kodik.cc",
          "https://kodik.video",
          "https://kodik.biz",
          "https://aniqit.com",
          "https://hencdn.top"
        ],
        "imageOrigins": ["https://anitokyo.tv", "https://picmap.top"],
        "streamOrigins": [
          "https://solodcdn.com",
          "https://storage-hencdn.com",
          "https://kodik-storage.com",
          "https://kodik.cc",
          "https://kodik.info",
          "https://aniqit.com",
          "https://hencdn.top"
        ],
        "methods": ["GET", "POST"],
        "maxConcurrentRequests": 4,
        "allowUserBaseUrl": true,
        "allowSubdomains": true,
        "userBaseUrlUses": ["image"]
