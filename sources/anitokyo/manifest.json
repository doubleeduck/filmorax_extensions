  "publisherKeyId": "filmorax.sources",
  "entrypoint": "src/index.mjs",
  "permissions": ["http", "html", "settings"],
  "sources": [
    {
      "id": "anitokyo",
      "name": "Anitokyo",
      "description": "source.description.anitokyo",
      "language": "russian",
      "category": "anime",
      "baseUrl": "https://anitokyo.tv",
      "isNsfw": false,
      "supportsTorrentSearch": true,
      "capabilities": [
        "catalog",
        "search",
        "filters",
        "metadata",
        "playbackGroups",
        "recommendations",
        "streams",
        "headers"
