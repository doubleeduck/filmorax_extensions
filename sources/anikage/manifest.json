{
  "schemaVersion": 1,
  "sourceApiVersion": 1,
  "minRuntimeAbi": 1,
  "id": "filmorax.source.anikage",
  "name": "Anikage",
  "description": "Anikage catalogue, all filters, episodes, recommendations and native streams",
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "publisherKeyId": "filmorax.sources",
  "entrypoint": "src/index.mjs",
  "permissions": ["http", "html", "settings"],
  "sources": [
    {
      "id": "anikage",
      "name": "Anikage",
      "description": "source.description.anikage",
      "language": "english",
      "category": "anime",
      "baseUrl": "https://anikage.cc",
      "isNsfw": false,
      "supportsTorrentSearch": true,
      "capabilities": [
        "catalog",
        "search",
        "filters",
        "metadata",
        "playbackGroups",
        "streams",
        "recommendations"
      ],
      "parameters": {
        "proxyOrigin": "https://og.bakayaro.live"
      },
      "network": {
        "origins": ["https://anikage.cc"],
        "imageOrigins": ["https://s4.anilist.co", "https://s3.anilist.co"],
        "streamOrigins": ["https://og.bakayaro.live"],
        "methods": ["GET"],
        "maxConcurrentRequests": 4,
        "allowUserBaseUrl": true
      },
      "presentation": {
        "icon": "assets/icon.png",
        "directPlayback": false,
        "artworkLayout": "portrait",
        "imageHeaders": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
          "Accept": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
          "Accept-Language": "en-US,en;q=0.9,ru;q=0.7"
        }
      }
    }
  ],
  "resolvers": [
    {
      "id": "anikage.streams",
      "sourceId": "anikage",
      "schemes": ["anikage"],
      "origins": []
    }
  ],
  "contributions": {
    "hostFeatures": []
  },
  "files": {}
}
